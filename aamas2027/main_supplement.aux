\@writefile{lot}{\contentsline {table}{\numberline {S5}{\ignorespaces Headline degradation study (RQ1), \textbf  {synthetic effect model} ($M{=}738$, $\epsilon {=}\alpha {=}0.05$, seed-locked). $\mathrm  {ASR}_{\mathrm  {act}}^{\dagger }\downarrow $ / $\mathrm  {NRP}_{\mathrm  {sys}}^{\dagger }\uparrow $ are better. Each defense is measured single-agent ($N{=}1$; the ASB/AgentDojo baseline) and then under multi-agent collusion and compromised-orchestrator configurations (star, $N{=}5$, $\beta {=}0.3$). The guardrail's relative $\mathrm  {ASR}_{\mathrm  {act}}^{\dagger }$ reduction over no-defense is $41.6\%\to 31.8\%\to 27.6\%$ left to right; the $\dagger $ marks the \emph  {single-agent} predicate, so these columns are not the system metric, and the shrinkage between them is not statistically resolved at this budget (\Cref  {app:power}).}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:degradation}{{S5}{10}{Headline degradation study (RQ1), \textbf {synthetic effect model} ($M{=}738$, $\epsilon {=}\alpha {=}0.05$, seed-locked). $\ASRa ^{\dagger }\downarrow $ / $\NRPs ^{\dagger }\uparrow $ are better. Each defense is measured single-agent ($N{=}1$; the ASB/AgentDojo baseline) and then under multi-agent collusion and compromised-orchestrator configurations (star, $N{=}5$, $\betafrac {=}0.3$). The guardrail's relative $\ASRa ^{\dagger }$ reduction over no-defense is $41.6\%\to 31.8\%\to 27.6\%$ left to right; the $\dagger $ marks the \emph {single-agent} predicate, so these columns are not the system metric, and the shrinkage between them is not statistically resolved at this budget (\Cref {app:power})}{table.caption.9}{}}
\newlabel{tab:degradation@cref}{{[table][5][]S5}{[1][9][]10}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S6}{\ignorespaces Sybil study (RQ5), \textbf  {synthetic effect model} (star, $N{=}5$, $\beta {=}0.1$, \emph  {independent} (non-colluding) adversary, no defense, $M{=}738$). The expected trend---$\mathrm  {ASR}_{\mathrm  {sys}}$ increases with the Sybil count until the system is fully seeded---is observed: $\mathrm  {ASR}_{\mathrm  {sys}}$ rises monotonically as Sybil identities inflate the adversary's initial footprint, and $\mathrm  {NRP}_{\mathrm  {sys}}$ falls to zero at full seeding. The count-$0$ row is the \emph  {independent}-seeding cell of the collusion sweep of \Cref  {tab:collusion} at the same operating point, which is why its $\mathrm  {ASR}_{\mathrm  {sys}}$ is $0.775$ there and $1.000$ for colluding seeding in that table: the two tables differ in the coordination mode, not in the setting.}}{10}{table.caption.10}\protected@file@percent }
\newlabel{tab:sybil}{{S6}{10}{Sybil study (RQ5), \textbf {synthetic effect model} (star, $N{=}5$, $\betafrac {=}0.1$, \emph {independent} (non-colluding) adversary, no defense, $M{=}738$). The expected trend---$\ASRs $ increases with the Sybil count until the system is fully seeded---is observed: $\ASRs $ rises monotonically as Sybil identities inflate the adversary's initial footprint, and $\NRPs $ falls to zero at full seeding. The count-$0$ row is the \emph {independent}-seeding cell of the collusion sweep of \Cref {tab:collusion} at the same operating point, which is why its $\ASRs $ is $0.775$ there and $1.000$ for colluding seeding in that table: the two tables differ in the coordination mode, not in the setting}{table.caption.10}{}}
\newlabel{tab:sybil@cref}{{[table][6][]S6}{[1][9][]10}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S7}{\ignorespaces Adaptivity study (RQ6), \textbf  {synthetic effect model} (star, $N{=}5$, $M{=}60$ per scored pair, $R{=}20$ \textsc  {CoRB}\xspace  {} rounds). An adaptive red policy (the harness's best-response proposer) erodes the co-adapting blue's $\mathrm  {NRP}_{\mathrm  {sys}}$ from $0.649$ to $0.236$ in the \emph  {unsafe-action} channel; a random (``static'') red leaves the system in the availability-sabotage regime ($\mathrm  {ASR}_{\mathrm  {sys}}{=}1$, $\mathrm  {NRP}_{\mathrm  {sys}}{=}0$) from the first round. Under the \emph  {system} predicate, therefore, static red is the stronger attacker and adaptivity is visible only in the action channel---the opposite of the natural reading, and a direct consequence of the saturation described in \Cref  {app:harness}. The adaptive sequence is also non-monotone ($r{=}10$: $0.783$, $r{=}20$: $0.733$), which $M{=}60$ episodes per pair does not resolve; we report it as measured, not as convergence.}}{10}{table.caption.11}\protected@file@percent }
\newlabel{tab:adaptive}{{S7}{10}{Adaptivity study (RQ6), \textbf {synthetic effect model} (star, $N{=}5$, $M{=}60$ per scored pair, $R{=}20$ \corb {} rounds). An adaptive red policy (the harness's best-response proposer) erodes the co-adapting blue's $\NRPs $ from $0.649$ to $0.236$ in the \emph {unsafe-action} channel; a random (``static'') red leaves the system in the availability-sabotage regime ($\ASRs {=}1$, $\NRPs {=}0$) from the first round. Under the \emph {system} predicate, therefore, static red is the stronger attacker and adaptivity is visible only in the action channel---the opposite of the natural reading, and a direct consequence of the saturation described in \Cref {app:harness}. The adaptive sequence is also non-monotone ($r{=}10$: $0.783$, $r{=}20$: $0.733$), which $M{=}60$ episodes per pair does not resolve; we report it as measured, not as convergence}{table.caption.11}{}}
\newlabel{tab:adaptive@cref}{{[table][7][]S7}{[1][9][]10}{}{}{}}
