\@writefile{lot}{\contentsline {table}{\numberline {S9}{\ignorespaces Scalability and cost (RQ6), \textbf  {synthetic effect model} (star, no defense, $\beta {=}0.3$, $M{=}738$). Token cost grows linearly in $N$ ($\approx 8.8{\times }N$ tokens per episode) because the cost model is \emph  {defined} as linear in the agent count, so this column is a model output, not a measured runtime. Latency is the synthetic per-call proxy, in arbitrary units (a.u.), and stays near-flat. $\mathrm  {ASR}_{\mathrm  {sys}}$ saturates via availability sabotage (\Cref  {tab:degradation}).}}{12}{table.caption.13}\protected@file@percent }
\newlabel{tab:cost}{{S9}{12}{Scalability and cost (RQ6), \textbf {synthetic effect model} (star, no defense, $\betafrac {=}0.3$, $M{=}738$). Token cost grows linearly in $N$ ($\approx 8.8{\times }N$ tokens per episode) because the cost model is \emph {defined} as linear in the agent count, so this column is a model output, not a measured runtime. Latency is the synthetic per-call proxy, in arbitrary units (a.u.), and stays near-flat. $\ASRs $ saturates via availability sabotage (\Cref {tab:degradation})}{table.caption.13}{}}
\newlabel{tab:cost@cref}{{[table][9][]S9}{[1][9][]12}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S10}{\ignorespaces LLM backbone pilot, \textbf  {PILOT-labelled} (Qwen2.5 \{$0.5$B,$1.5$B,$3$B,$7$B\} and Llama-3.2 \{$1$B,$3$B\}, $12$ configs $\{$star, chain, tree, mesh$\}$ $\times $ $N\in \{3,5,10\}$, $M{=}100$ per (config, scenario), no defense, fictitious payload data). Backbones differ in their security decision: the Qwen family (all four sizes) and Llama-$3$B refuse every direct exfiltration instruction (parse failures are logged per decision and are zero in these cells), yet $\mathrm  {ASR}_{\mathrm  {sys}}$ is still positive in the hub-critical topologies via structural availability sabotage---star and tree collapse to $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ under collusion and orchestrator compromise, while chain stays $\leq \!0.25$; Llama-$1$B \emph  {complies}, yielding $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ across all attack scenarios, as does Mistral-7B (\Cref  {sec:experiments}). The refusal columns are the control evidence behind \Cref  {app:limitations}: most backbones tested \emph  {with} a defense refuse the same request \emph  {without} one. The registered security outcome is otherwise a real model property, not a framework artefact.}}{12}{table.caption.15}\protected@file@percent }
\newlabel{tab:llm_pilot}{{S10}{12}{LLM backbone pilot, \textbf {PILOT-labelled} (Qwen2.5 \{$0.5$B,$1.5$B,$3$B,$7$B\} and Llama-3.2 \{$1$B,$3$B\}, $12$ configs $\{$star, chain, tree, mesh$\}$ $\times $ $N\in \{3,5,10\}$, $M{=}100$ per (config, scenario), no defense, fictitious payload data). Backbones differ in their security decision: the Qwen family (all four sizes) and Llama-$3$B refuse every direct exfiltration instruction (parse failures are logged per decision and are zero in these cells), yet $\ASRs $ is still positive in the hub-critical topologies via structural availability sabotage---star and tree collapse to $\ASRs {=}1.000$ under collusion and orchestrator compromise, while chain stays $\leq \!0.25$; Llama-$1$B \emph {complies}, yielding $\ASRs {=}1.000$ across all attack scenarios, as does Mistral-7B (\Cref {sec:experiments}). The refusal columns are the control evidence behind \Cref {app:limitations}: most backbones tested \emph {with} a defense refuse the same request \emph {without} one. The registered security outcome is otherwise a real model property, not a framework artefact}{table.caption.15}{}}
\newlabel{tab:llm_pilot@cref}{{[table][10][]S10}{[1][10][]12}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S11}{\ignorespaces LLM backbone pilot, topology study (RQ4), \textbf  {PILOT-labelled}: six open instruct backbones, $12$ configs, $M{=}100$ per (config, scenario), no defense. $\mathrm  {CPR}$ is a deterministic structural functional of the topology and is \emph  {identical across all six backbones}, so one column reports it; it orders as \Cref  {prop:chain,prop:star,prop:tree,prop:mesh} predict (chain $0.130<$ tree $0.198<$ star $0.286<$ mesh $0.627$). $\mathrm  {ASR}_{\mathrm  {sys}}$ is topology-dependent for the five refusing backbones; the complying backbone saturates at $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ everywhere.}}{12}{table.caption.16}\protected@file@percent }
\newlabel{tab:llm_pilot_topology}{{S11}{12}{LLM backbone pilot, topology study (RQ4), \textbf {PILOT-labelled}: six open instruct backbones, $12$ configs, $M{=}100$ per (config, scenario), no defense. $\CPR $ is a deterministic structural functional of the topology and is \emph {identical across all six backbones}, so one column reports it; it orders as \Cref {prop:chain,prop:star,prop:tree,prop:mesh} predict (chain $0.130<$ tree $0.198<$ star $0.286<$ mesh $0.627$). $\ASRs $ is topology-dependent for the five refusing backbones; the complying backbone saturates at $\ASRs {=}1.000$ everywhere}{table.caption.16}{}}
