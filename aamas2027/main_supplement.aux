\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Sybil study (RQ5), \textbf  {synthetic-model} results (star, $N{=}5$, $\beta {=}0.1$, no defense, $M{=}738$). The expected trend---$\mathrm  {ASR}_{\mathrm  {sys}}$ increases with the Sybil count until the system is fully seeded---is observed: $\mathrm  {ASR}_{\mathrm  {sys}}$ rises monotonically as Sybil identities inflate the adversary's initial footprint, and $\mathrm  {NRP}_{\mathrm  {sys}}$ falls to zero at full seeding.}}{6}{table.caption.10}\protected@file@percent }
\newlabel{tab:sybil}{{6}{6}{Sybil study (RQ5), \textbf {synthetic-model} results (star, $N{=}5$, $\betafrac {=}0.1$, no defense, $M{=}738$). The expected trend---$\ASRs $ increases with the Sybil count until the system is fully seeded---is observed: $\ASRs $ rises monotonically as Sybil identities inflate the adversary's initial footprint, and $\NRPs $ falls to zero at full seeding}{table.caption.10}{}}
\newlabel{tab:sybil@cref}{{[table][6][]6}{[1][6][]6}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces Adaptivity study, \textbf  {synthetic-model} results (star, $N{=}5$, $M{=}60$ per scored pair, $R{=}20$ \textsc  {CoRB}\xspace  {} rounds). An adaptive red (Algorithm\nonbreakingspace 2 best-responder) erodes the co-adapting blue's $\mathrm  {NRP}_{\mathrm  {sys}}$ from $0.649$ to $0.236$; a random (``static'') red leaves the system in the availability-sabotage regime ($\mathrm  {ASR}_{\mathrm  {sys}}{=}1$, $\mathrm  {NRP}_{\mathrm  {sys}}{=}0$) throughout.}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:adaptive}{{7}{6}{Adaptivity study, \textbf {synthetic-model} results (star, $N{=}5$, $M{=}60$ per scored pair, $R{=}20$ \corb {} rounds). An adaptive red (Algorithm~2 best-responder) erodes the co-adapting blue's $\NRPs $ from $0.649$ to $0.236$; a random (``static'') red leaves the system in the availability-sabotage regime ($\ASRs {=}1$, $\NRPs {=}0$) throughout}{table.caption.11}{}}
\newlabel{tab:adaptive@cref}{{[table][7][]7}{[1][6][]6}{}{}{}}
