\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces LLM backbone pilot, \textbf  {PILOT-labelled} (Qwen2.5 \{$0.5$B,$1.5$B,$3$B,$7$B\} and Llama-3.2 \{$1$B,$3$B\}, $12$ configs $\{$star, chain, tree, mesh$\}$ $\times $ $N\in \{3,5,10\}$, $M{=}100$ per (config, scenario), no defense, fictitious payload data). Backbones differ in their security decision: the Qwen family (all four sizes) and Llama-$3$B refuse every direct exfiltration instruction (almost all parse failures 0), yet $\mathrm  {ASR}_{\mathrm  {sys}}$ is still positive in the hub-critical topologies via structural availability sabotage---star and tree collapse to $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ under collusion and orchestrator compromise, while chain stays $\leq \!0.25$; Llama-$1$B \emph  {complies}, yielding $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ across all attack scenarios, as does Mistral-7B (\Cref  {sec:experiments}). The registered security outcome is a real model property, not a framework artefact.}}{8}{table.caption.15}\protected@file@percent }
\newlabel{tab:llm_pilot}{{10}{8}{LLM backbone pilot, \textbf {PILOT-labelled} (Qwen2.5 \{$0.5$B,$1.5$B,$3$B,$7$B\} and Llama-3.2 \{$1$B,$3$B\}, $12$ configs $\{$star, chain, tree, mesh$\}$ $\times $ $N\in \{3,5,10\}$, $M{=}100$ per (config, scenario), no defense, fictitious payload data). Backbones differ in their security decision: the Qwen family (all four sizes) and Llama-$3$B refuse every direct exfiltration instruction (almost all parse failures 0), yet $\ASRs $ is still positive in the hub-critical topologies via structural availability sabotage---star and tree collapse to $\ASRs {=}1.000$ under collusion and orchestrator compromise, while chain stays $\leq \!0.25$; Llama-$1$B \emph {complies}, yielding $\ASRs {=}1.000$ across all attack scenarios, as does Mistral-7B (\Cref {sec:experiments}). The registered security outcome is a real model property, not a framework artefact}{table.caption.15}{}}
\newlabel{tab:llm_pilot@cref}{{[table][10][]10}{[1][7][]8}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces LLM backbone pilot, topology study (RQ4), \textbf  {PILOT-labelled}: six open instruct backbones, $12$ configs, $M{=}100$ per (config, scenario), no defense. $\mathrm  {CPR}$ is a deterministic structural functional of the topology and is \emph  {identical across all six backbones}, so one column reports it; it orders as \Cref  {prop:chain,prop:star,prop:tree,prop:mesh} predict (chain $0.130<$ tree $0.198<$ star $0.286<$ mesh $0.627$). $\mathrm  {ASR}_{\mathrm  {sys}}$ is topology-dependent for the five refusing backbones; the complying backbone saturates at $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ everywhere.}}{8}{table.caption.16}\protected@file@percent }
\newlabel{tab:llm_pilot_topology}{{11}{8}{LLM backbone pilot, topology study (RQ4), \textbf {PILOT-labelled}: six open instruct backbones, $12$ configs, $M{=}100$ per (config, scenario), no defense. $\CPR $ is a deterministic structural functional of the topology and is \emph {identical across all six backbones}, so one column reports it; it orders as \Cref {prop:chain,prop:star,prop:tree,prop:mesh} predict (chain $0.130<$ tree $0.198<$ star $0.286<$ mesh $0.627$). $\ASRs $ is topology-dependent for the five refusing backbones; the complying backbone saturates at $\ASRs {=}1.000$ everywhere}{table.caption.16}{}}
\newlabel{tab:llm_pilot_topology@cref}{{[table][11][]11}{[1][7][]8}{}{}{}}
