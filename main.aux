\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces LLM backbone pilot, \textbf  {PILOT-labelled} (Qwen2.5 \{$0.5$B,$1.5$B,$3$B,$7$B\} and Llama-3.2 \{$1$B,$3$B\}, $12$ configs $\{$star, chain, tree, mesh$\}$ $\times $ $N\in \{3,5,10\}$, $M{=}100$ per (config, scenario), no defense, fictitious data; numbers excluded from the headlined synthetic tables). Backbones differ in their security decision: the Qwen family (all four sizes) and Llama-$3$B refuse every direct exfiltration instruction (almost all parse failures 0), yet $\mathrm  {ASR}_{\mathrm  {sys}}$ is still positive in the hub-critical topologies via structural availability sabotage---star and tree collapse to $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ under collusion and orchestrator compromise, while chain stays $\leq \!0.25$; Llama-$1$B \emph  {complies}, yielding $\mathrm  {ASR}_{\mathrm  {sys}}{=}1.000$ across all attack scenarios. The registered security outcome is a real model property, not a framework artefact.}}{35}{table.caption.37}\protected@file@percent }
\newlabel{tab:llm_pilot}{{9}{35}{LLM backbone pilot, \textbf {PILOT-labelled} (Qwen2.5 \{$0.5$B,$1.5$B,$3$B,$7$B\} and Llama-3.2 \{$1$B,$3$B\}, $12$ configs $\{$star, chain, tree, mesh$\}$ $\times $ $N\in \{3,5,10\}$, $M{=}100$ per (config, scenario), no defense, fictitious data; numbers excluded from the headlined synthetic tables). Backbones differ in their security decision: the Qwen family (all four sizes) and Llama-$3$B refuse every direct exfiltration instruction (almost all parse failures 0), yet $\ASRs $ is still positive in the hub-critical topologies via structural availability sabotage---star and tree collapse to $\ASRs {=}1.000$ under collusion and orchestrator compromise, while chain stays $\leq \!0.25$; Llama-$1$B \emph {complies}, yielding $\ASRs {=}1.000$ across all attack scenarios. The registered security outcome is a real model property, not a framework artefact}{table.caption.37}{}}
\newlabel{tab:llm_pilot@cref}{{[table][9][]9}{[1][34][]35}{}{}{}}
