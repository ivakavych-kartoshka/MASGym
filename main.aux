\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Conceptual expected trends; not experimental results---placeholder curves to be replaced with measured data before submission.} Shapes are drawn from the theory of \Cref  {sec:theory}: (a) a defense's $\mathrm  {NRP}_{\mathrm  {sys}}$ advantage over no-defense is expected to shrink under collusion and orchestrator compromise (RQ3, the headline \emph  {hypothesis}); (b) the compromise-propagation rate is expected to increase across topologies chain $<$ subcritical tree $<$ star $<$ mesh (\Cref  {prop:chain,prop:star,prop:tree,prop:mesh}, RQ4); (c) colluding adversaries are expected to achieve higher $\mathrm  {ASR}_{\mathrm  {sys}}$ than independent ones at equal fraction (\Cref  {thm:collusion}, RQ5); and (d) cost is expected to grow with agent count and topology density (RQ6). No claim of measured superiority is made.\relax }}{27}{figure.caption.16}\protected@file@percent }
\newlabel{fig:results}{{6}{27}{\textbf {Conceptual expected trends; not experimental results---placeholder curves to be replaced with measured data before submission.} Shapes are drawn from the theory of \Cref {sec:theory}: (a) a defense's $\NRPs $ advantage over no-defense is expected to shrink under collusion and orchestrator compromise (RQ3, the headline \emph {hypothesis}); (b) the compromise-propagation rate is expected to increase across topologies chain $<$ subcritical tree $<$ star $<$ mesh (\Cref {prop:chain,prop:star,prop:tree,prop:mesh}, RQ4); (c) colluding adversaries are expected to achieve higher $\ASRs $ than independent ones at equal fraction (\Cref {thm:collusion}, RQ5); and (d) cost is expected to grow with agent count and topology density (RQ6). No claim of measured superiority is made.\relax }{figure.caption.16}{}}
\newlabel{fig:results@cref}{{[figure][6][]6}{[1][24][]27}}
